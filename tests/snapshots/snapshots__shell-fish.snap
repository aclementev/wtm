---
source: tests/snapshots.rs
expression: "run(&[\"shell\", shell])"
---
function wtm
    switch "$argv[1]"
        case new cd
            set -l out (command wtm $argv)
            set -l rc $status
            if test -d "$out"
                cd "$out"
            else if test -n "$out"
                printf '%s\n' "$out"
            end
            return $rc
        case '*'
            command wtm $argv
    end
end
